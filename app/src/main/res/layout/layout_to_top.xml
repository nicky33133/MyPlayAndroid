<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/toTopSmartRefreshLayout">


        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/toTopRecycleView"/>

    </com.scwang.smart.refresh.layout.SmartRefreshLayout>

    <ImageView
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:id="@+id/toTopIvClick"
        android:layout_gravity="end|bottom"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:layout_marginVertical="@dimen/dp_85"
        android:background="@drawable/to_top_bg"
        android:padding="@dimen/dp_10"
        android:src="@drawable/ic_to_top"
        android:visibility="gone" />
<!--    tools:ignore="ContentDescription" 是 Android XML 布局文件中的一个属性，
它的作用是让 Android Studio 的 Lint 代码检查工具忽略（不再报黄色警告）关于“缺少图片内容描述”的问题。-->

</FrameLayout>